<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane
        prefHeight="720.0" prefWidth="1000.0"
        style="-fx-background-color: #f8fafc;"
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.gui.kline.controller.QuickActionsUseController">

    <children>
        <VBox spacing="0"
              AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">

            <HBox alignment="CENTER_LEFT" spacing="16"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24 32; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                <VBox.margin>
                    <Insets top="28" left="32" right="32" bottom="0" />
                </VBox.margin>

                <StackPane style="-fx-background-color: #fef3c7; -fx-background-radius: 10; -fx-min-width: 44; -fx-min-height: 44; -fx-max-width: 44; -fx-max-height: 44;">
                    <FontIcon iconLiteral="fas-bolt" iconSize="20" iconColor="#d97706" />
                </StackPane>

                <VBox spacing="4">
                    <Label text="Quick Actions"
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                    <Label fx:id="lblSubtitle" text="Tap a service to log it instantly"
                           style="-fx-font-size: 13px; -fx-text-fill: #64748b;" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <HBox spacing="16" alignment="CENTER">
                    <HBox spacing="16" alignment="CENTER">
                        <Button text="  Manage Quick Actions" onAction="#handleManageQuickActions"
                            style="-fx-background-color: #f1f5f9; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-padding: 9 16; -fx-cursor: hand; -fx-font-size: 13px;">
                            <graphic><FontIcon iconLiteral="fas-cog" iconSize="13" iconColor="#475569" /></graphic>
                        </Button>
                        <HBox alignment="CENTER" spacing="6"
                              style="-fx-background-color: #ecfdf5; -fx-border-color: #a7f3d0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 16;">
                            <Label text="TODAY'S SERVICES :"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #10b981;" />
                            <Label fx:id="lblTodayCount" text="0"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #059669;" />
                        </HBox>
                        <HBox alignment="CENTER" spacing="6"
                              style="-fx-background-color: #eff6ff; -fx-border-color: #bfdbfe; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 16;">
                            <Label text="TODAY'S REVENUE :"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #3b82f6;" />
                            <Label fx:id="lblTodayRevenue" text="Rs. 0"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2563eb;" />
                        </HBox>
                    </HBox>
                </HBox>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
                <padding><Insets top="24" left="32" right="32" bottom="32" /></padding>

                <GridPane fx:id="actionsGrid" hgap="24" vgap="24">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25" />
                    </columnConstraints>
                </GridPane>
            </ScrollPane>
        </VBox>
    </children>
</AnchorPane>
