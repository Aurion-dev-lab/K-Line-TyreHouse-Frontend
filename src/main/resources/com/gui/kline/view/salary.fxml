<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="1000.0" prefWidth="1000.0" styleClass="root-container" stylesheets="@../css/salary.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gui.kline.controller.SalaryController">
    <children>
        <ScrollPane fitToHeight="false" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
            <content>
                <VBox spacing="24.0" style="-fx-padding: 30;">

                     <HBox alignment="CENTER_LEFT" spacing="16.0">
                         <children>
                             <VBox spacing="4.0">
                                 <Label styleClass="page-title" text="Salary Management" />
                                 <Label styleClass="page-subtitle" text="Calculate monthly payouts based on attendance" />
                             </VBox>
                             <Region HBox.hgrow="ALWAYS" />
                       <AnchorPane>
                          <children>
                                     <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="246.0" spacing="10.0" styleClass="month-picker-box">
                                       <Label styleClass="month-picker-icon" text="📅" />
                                       <ComboBox fx:id="cmbSalaryMonth" prefWidth="140.0" styleClass="combo-month" />
                                    </HBox>
                          </children>
                       </AnchorPane>
                       <AnchorPane>
                          <children>
                                     <Button fx:id="btnRecordAdvance" layoutY="6.0" onAction="#handleRecordAdvance" prefHeight="43.0" prefWidth="120.0" styleClass="btn-action-amber" text="Advance">
                                         <graphic>
                                             <Label style="-fx-text-fill: white; -fx-font-size: 13px;" text="➕" />
                                         </graphic>
                                    </Button>
                          </children>
                       </AnchorPane>
                       <AnchorPane>
                          <children>
                                     <Button fx:id="btnGiveCredit" layoutY="6.0" onAction="#handleGiveCredit" styleClass="btn-action-danger" text="Credit">
                                         <graphic>
                                             <Label style="-fx-text-fill: white; -fx-font-size: 13px;" text="💰" />
                                         </graphic>
                                    </Button>
                          </children>
                       </AnchorPane>
                       <AnchorPane>
                          <children>
                                     <Button fx:id="btnSettleCredit" layoutY="6.0" onAction="#handleSettleCredit" styleClass="btn-action-success" text="Settle Credit">
                                         <graphic>
                                             <Label style="-fx-text-fill: white; -fx-font-size: 13px;" text="✅" />
                                         </graphic>
                                    </Button>
                          </children>
                       </AnchorPane>
                               <Button fx:id="btnExportPayroll" onAction="#handleExportPayroll" styleClass="btn-action-dark">
                                   <graphic>
                                       <Label style="-fx-text-fill: white; -fx-font-size: 13px;" text="📤" />
                                   </graphic>
                              </Button>
                         </children>
                     </HBox>

                    <HBox spacing="16.0">
                        <VBox spacing="12.0" styleClass="metric-card-green" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                 <StackPane styleClass="icon-box-green">
                                     <Label style="-fx-text-fill: #059669; -fx-font-size: 18px;" text="✓" />
                                 </StackPane>
                                <Label styleClass="metric-title" text="PAID SALARY" />
                            </HBox>
                            <Label fx:id="lblPaidSalary" styleClass="metric-value-green" text="Rs. 0" />
                            <Label styleClass="metric-subtitle" text="Paid in selected period" />
                        </VBox>

                        <VBox spacing="12.0" styleClass="metric-card" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                 <StackPane styleClass="icon-box-green">
                                     <Label style="-fx-text-fill: #059669; -fx-font-size: 18px;" text="👛" />
                                 </StackPane>
                                <Label styleClass="metric-title" text="NET PAYOUT" />
                            </HBox>
                            <Label fx:id="lblNetPayout" styleClass="metric-value-dark" text="Rs. 0" />
                            <Label fx:id="lblGross" styleClass="metric-subtitle" text="Gross: Rs. 0" />
                        </VBox>

                        <VBox spacing="12.0" styleClass="metric-card" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                 <StackPane styleClass="icon-box-amber">
                                     <Label style="-fx-text-fill: #f59e0b; -fx-font-size: 18px;" text="⏱" />
                                 </StackPane>
                                <Label styleClass="metric-title" text="TOTAL ADVANCES" />
                            </HBox>
                            <Label fx:id="lblTotalAdvances" styleClass="metric-value-amber" text="Rs. 0" />
                            <Label styleClass="metric-subtitle" text="Deducted from gross" />
                        </VBox>

                        <VBox spacing="12.0" styleClass="metric-card-rose" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                 <StackPane styleClass="icon-box-rose">
                                     <Label style="-fx-text-fill: #e11d48; -fx-font-size: 18px;" text="💳" />
                                 </StackPane>
                                <Label styleClass="metric-title" text="CREDIT BALANCE" />
                            </HBox>
                            <Label fx:id="lblCreditBalance" styleClass="metric-value-rose" text="Rs. 0" />
                            <Label styleClass="metric-subtitle" text="Outstanding credits" />
                        </VBox>

                        <VBox spacing="12.0" styleClass="metric-card" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                 <StackPane styleClass="icon-box-blue">
                                     <Label style="-fx-text-fill: #2563eb; -fx-font-size: 18px;" text="👥" />
                                 </StackPane>
                                <Label styleClass="metric-title" text="ACTIVE WORKERS" />
                            </HBox>
                            <Label fx:id="lblActiveWorkers" styleClass="metric-value-dark" text="0" />
                            <Label fx:id="lblWorkersSubtitle" styleClass="metric-subtitle" text="Out of 0 registered" />
                        </VBox>
                    </HBox>

                    <VBox styleClass="card-container">
                        <TableView fx:id="tblSalary" prefHeight="220.0" styleClass="salary-table-view">
                            <columns>
                                <TableColumn fx:id="colWorker" prefWidth="200.0" text="WORKER" />
                                <TableColumn fx:id="colAttendance" prefWidth="160.0" text="ATTENDANCE" />
                                <TableColumn fx:id="colGrossSalary" prefWidth="130.0" text="GROSS SALARY" />
                                <TableColumn fx:id="colAdvances" prefWidth="110.0" text="ADVANCES" />
                                <TableColumn fx:id="colCreditBalance" prefWidth="130.0" text="CREDIT BALANCE" />
                                <TableColumn fx:id="colNetPayable" prefWidth="120.0" text="NET PAYABLE" />
                                <TableColumn fx:id="colStatus" prefWidth="100.0" text="STATUS" />
                                <TableColumn fx:id="colSalaryActions" prefWidth="170.0" text="PAYMENT" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>

                    <!-- Payouts & Advances Ledger -->
                    <VBox spacing="0" styleClass="card-container">
                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 20 24 16 24;">
                             <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <Label style="-fx-text-fill: #059669; -fx-font-size: 16px;" text="📜" />
                                 <Label styleClass="ledger-header-title" text="Payouts &amp; Advances Ledger" />
                            </HBox>
                            <Region HBox.hgrow="ALWAYS" />
                            <Label styleClass="ledger-header-subtitle" text="History of salary advances handed out and salary payments executed" />
                        </HBox>

                        <TableView fx:id="tblPayoutLedger" prefHeight="220.0" styleClass="salary-table-view">
                            <columns>
                                <TableColumn fx:id="colPayoutDate" prefWidth="130.0" text="DATE" />
                                <TableColumn fx:id="colPayoutWorker" prefWidth="160.0" text="WORKER" />
                                <TableColumn fx:id="colPayoutType" prefWidth="150.0" text="TYPE" />
                                <TableColumn fx:id="colPayoutNote" prefWidth="280.0" text="NOTE / PERIOD" />
                                <TableColumn fx:id="colPayoutAmount" prefWidth="150.0" text="AMOUNT" />
                                <TableColumn fx:id="colPayoutActions" prefWidth="80.0" text="ACTIONS" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <VBox spacing="12.0" style="-fx-padding: 20 24 24 24;">
                             <HBox alignment="CENTER_LEFT" spacing="10">
                                 <Label style="-fx-text-fill: #9ca3af; -fx-font-size: 11px;" text="ℹ" />
                                 <Label styleClass="section-label" text="PAYOUT SUMMARY BY WORKER" />
                            </HBox>
                            <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" prefHeight="150.0" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" vbarPolicy="NEVER">
                                <content>
                                    <HBox fx:id="hboxPayoutSummary" spacing="16.0" />
                                </content>
                            </ScrollPane>
                        </VBox>
                    </VBox>

                    <!-- Credit Ledger -->
                    <VBox spacing="0" styleClass="card-container">
                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 20 24 16 24;">
                             <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <Label style="-fx-text-fill: #e11d48; -fx-font-size: 16px;" text="📖" />
                                 <Label styleClass="ledger-header-title" text="Credit Ledger" />
                            </HBox>
                            <Region HBox.hgrow="ALWAYS" />
                            <Label styleClass="ledger-header-subtitle" text="Workers who took items/money on credit — settled through work" />
                        </HBox>

                        <TableView fx:id="tblLedger" prefHeight="220.0" styleClass="salary-table-view">
                            <columns>
                                <TableColumn fx:id="colLedgerDate" prefWidth="130.0" text="DATE" />
                                <TableColumn fx:id="colLedgerWorker" prefWidth="160.0" text="WORKER" />
                                <TableColumn fx:id="colLedgerType" prefWidth="150.0" text="TYPE" />
                                <TableColumn fx:id="colLedgerNote" prefWidth="280.0" text="NOTE" />
                                <TableColumn fx:id="colLedgerAmount" prefWidth="150.0" text="AMOUNT" />
                                <TableColumn fx:id="colLedgerActions" prefWidth="80.0" text="ACTIONS" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <VBox spacing="12.0" style="-fx-padding: 20 24 24 24;">
                             <HBox alignment="CENTER_LEFT" spacing="10">
                                 <Label style="-fx-text-fill: #9ca3af; -fx-font-size: 11px;" text="ℹ" />
                                 <Label styleClass="section-label" text="CREDIT SUMMARY BY WORKER" />
                            </HBox>
                            <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" prefHeight="150.0" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" vbarPolicy="NEVER">
                                <content>
                                    <HBox fx:id="hboxCreditSummary" spacing="16.0" />
                                </content>
                            </ScrollPane>
                        </VBox>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>