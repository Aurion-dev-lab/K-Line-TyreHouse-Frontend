<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="0" styleClass="page-root" stylesheets="@../css/invoices.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gui.kline.controller.CreditCustomersController">
   <children>
      <!-- Header Bar -->
      <HBox alignment="CENTER_LEFT" spacing="16" styleClass="page-header-bar">
         <padding>
            <Insets bottom="18" left="28" right="28" top="22" />
         </padding>
         <children>
            <VBox spacing="3" HBox.hgrow="ALWAYS">
               <children>
                  <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Credit Customers" />
                  <Label style="-fx-font-size: 13px; -fx-text-fill: #6B7280;" text="Manage registered customers authorized for credit sales" />
               </children>
            </VBox>
            <Button fx:id="btnAddCustomer" onAction="#handleAddCustomer" styleClass="btn-primary" text="＋  Add Credit Customer" />
         </children>
      </HBox>

      <!-- Main Content Area -->
      <HBox spacing="14" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="14" left="20" right="20" top="0" />
         </padding>
         <children>
            <VBox spacing="0" styleClass="left-card" HBox.hgrow="ALWAYS">
               <children>
                  <!-- Table Control Bar -->
                  <HBox alignment="CENTER_LEFT" spacing="12" styleClass="table-header-bar">
                     <padding>
                        <Insets bottom="13" left="20" right="16" top="13" />
                     </padding>
                     <children>
                        <Label styleClass="card-title" text="Customer List" />
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtSearch" onKeyReleased="#handleSearch" prefHeight="32" prefWidth="220" promptText="⌕  Search…" styleClass="search-field" />
                        <Button fx:id="btnEdit" onAction="#handleEdit" styleClass="btn-primary" style="-fx-background-color: #6366F1; -fx-cursor: hand;" text="Edit" />
                        <Button fx:id="btnDelete" onAction="#handleDelete" styleClass="btn-primary" style="-fx-background-color: #EF4444; -fx-cursor: hand;" text="Delete" />
                     </children>
                  </HBox>

                  <!-- Table View wrapper -->
                  <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS" style="-fx-padding: 0; -fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                     <content>
                        <TableView fx:id="tblCustomers" maxHeight="1.7976931348623157E308" styleClass="main-table">
                          <columns>
                            <TableColumn fx:id="colName" prefWidth="180.0" text="NAME" />
                            <TableColumn fx:id="colPhone" prefWidth="130.0" text="PHONE" />
                            <TableColumn fx:id="colEmail" prefWidth="180.0" text="EMAIL" />
                            <TableColumn fx:id="colAddress" prefWidth="230.0" text="ADDRESS" />
                            <TableColumn fx:id="colUpdatedAt" prefWidth="140.0" text="LAST UPDATED" />
                          </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </content>
                  </ScrollPane>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
