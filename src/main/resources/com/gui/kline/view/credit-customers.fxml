<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="0" styleClass="page-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gui.kline.controller.CreditCustomersController">
   <stylesheets>
      <URL value="@../css/invoices.css" />
      <URL value="@../css/credit-customers.css" />
   </stylesheets>
   <children>
      <!-- Header Bar -->
      <HBox alignment="CENTER_LEFT" spacing="16" styleClass="page-header-bar">
         <padding>
            <Insets bottom="18" left="28" right="28" top="22" />
         </padding>
         <children>
            <VBox spacing="3" HBox.hgrow="ALWAYS">
               <children>
                  <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Credit Customers" />
                  <Label style="-fx-font-size: 13px; -fx-text-fill: #6B7280;" text="Manage registered customers authorized for credit sales" />
               </children>
            </VBox>
            <Button fx:id="btnAddCustomer" onAction="#handleAddCustomer" styleClass="btn-primary" text="＋  Add Credit Customer" />
         </children>
      </HBox>

      <!-- Tab Pane -->
      <TabPane fx:id="tabPane" styleClass="credit-customers-tab-pane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
         <tabs>
            <Tab text="Customer Management">
               <content>
                  <!-- Main Content Area -->
                  <HBox spacing="14" style="-fx-padding: 14 20 14 20;">
                     <children>
                        <VBox spacing="0" styleClass="left-card" HBox.hgrow="ALWAYS">
                           <children>
                              <!-- Table Control Bar -->
                              <HBox alignment="CENTER_LEFT" spacing="12" styleClass="table-header-bar">
                                 <padding>
                                    <Insets bottom="13" left="20" right="16" top="13" />
                                 </padding>
                                 <children>
                                    <Label styleClass="card-title" text="Customer List" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <TextField fx:id="txtSearch" onKeyReleased="#handleSearch" prefHeight="32" prefWidth="220" promptText="⌕  Search…" styleClass="search-field" />
                                    <Button fx:id="btnEdit" onAction="#handleEdit" styleClass="btn-primary" style="-fx-background-color: #6366F1; -fx-cursor: hand;" text="Edit" />
                                    <Button fx:id="btnDelete" onAction="#handleDelete" styleClass="btn-primary" style="-fx-background-color: #EF4444; -fx-cursor: hand;" text="Delete" />
                                 </children>
                              </HBox>

                              <!-- Table View wrapper -->
                              <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS" style="-fx-padding: 0; -fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                                 <content>
                                    <TableView fx:id="tblCustomers" maxHeight="1.7976931348623157E308" styleClass="main-table">
                                      <columns>
                                        <TableColumn fx:id="colName" prefWidth="180.0" text="NAME" />
                                        <TableColumn fx:id="colPhone" prefWidth="140.0" text="PHONE" />
                                        <TableColumn fx:id="colEmail" prefWidth="200.0" text="EMAIL" />
                                        <TableColumn fx:id="colAddress" prefWidth="240.0" text="ADDRESS" />
                                        <TableColumn fx:id="colUpdatedAt" prefWidth="140.0" text="LAST UPDATED" />
                                      </columns>
                                       <columnResizePolicy>
                                          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                       </columnResizePolicy>
                                    </TableView>
                                 </content>
                              </ScrollPane>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </content>
            </Tab>
            <Tab text="Credit Overview">
               <content>
                  <VBox spacing="16" style="-fx-padding: 16 20 16 20;">
                     <children>
                        <!-- KPI Metric Cards at the Top -->
                        <HBox spacing="16">
                           <children>
                              <VBox spacing="10" styleClass="metric-card" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                       <children>
                                          <Label text="📈" style="-fx-font-size: 18px; -fx-background-color: #EFF6FF; -fx-background-radius: 8; -fx-padding: 6 8 6 8;" />
                                          <Label text="TOTAL CREDIT EXTENDED" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6B7280; -fx-letter-spacing: 1.2;" />
                                       </children>
                                    </HBox>
                                    <Label fx:id="lblTotalCredit" styleClass="metric-value" text="Rs. 0.00" />
                                 </children>
                              </VBox>

                              <VBox spacing="10" styleClass="metric-card" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                       <children>
                                          <Label styleClass="card-icon, card-icon-profit" text="💵" />
                                          <Label styleClass="metric-label" text="TOTAL SETTLED" />
                                       </children>
                                    </HBox>
                                    <Label fx:id="lblTotalSettled" styleClass="metric-value, positive-value" text="Rs. 0.00" />
                                 </children>
                              </VBox>

                              <VBox spacing="10" styleClass="metric-card-green" HBox.hgrow="ALWAYS" style="-fx-background-color: #1E293B;">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                       <children>
                                          <Label styleClass="card-icon, card-icon-income" text="📊" />
                                          <Label styleClass="metric-label-dark" text="TOTAL OUTSTANDING DUE" style="-fx-text-fill: #94A3B8;" />
                                       </children>
                                    </HBox>
                                    <Label fx:id="lblTotalDue" styleClass="metric-value-light" text="Rs. 0.00" style="-fx-text-fill: #F1F5F9;" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        <!-- Overview Card Layout FlowPane -->
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent; -fx-padding: 0;">
                           <content>
                              <FlowPane fx:id="flowCards" hgap="16" vgap="16" style="-fx-background-color: transparent; -fx-background: transparent;" />
                           </content>
                        </ScrollPane>
                     </children>
                  </VBox>
               </content>
            </Tab>
         </tabs>
      </TabPane>
   </children>
</VBox>
