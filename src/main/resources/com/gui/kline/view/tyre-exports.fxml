<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
        prefHeight="700.0" prefWidth="1000.0"
        styleClass="page-root"
        stylesheets="@../css/tyre-exports.css"
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.gui.kline.controller.TyreExportsController">

    <VBox spacing="0"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 24 28 16 28;">
            <VBox HBox.hgrow="ALWAYS" spacing="3">
                <Label text="Tyre Export Tracking" styleClass="page-title"/>
                <Label text="Manage bulk tyre shipments to companies" styleClass="page-subtitle"/>
            </VBox>
            <Button fx:id="btnNewExport" text="+ New Export Record" onAction="#handleNewExport"
                    styleClass="btn-new-export"/>
        </HBox>

        <!-- Stat Cards -->
        <HBox spacing="10" style="-fx-padding: 0 28 16 28;">
            <VBox prefWidth="160" styleClass="stat-card">
                <Label fx:id="lblShipments" text="0" styleClass="stat-value"/>
                <Label text="Shipments" styleClass="stat-label"/>
            </VBox>
            <VBox prefWidth="160" styleClass="stat-card">
                <Label fx:id="lblTyres" text="0" styleClass="stat-value"/>
                <Label text="Tyres exported" styleClass="stat-label"/>
            </VBox>
            <VBox prefWidth="160" styleClass="stat-card">
                <Label fx:id="lblGain" text="Rs. 0" styleClass="stat-value-gain"/>
                <Label text="Total Gain" styleClass="stat-label"/>
            </VBox>
            <VBox prefWidth="160" styleClass="stat-card">
                <Label fx:id="lblLoss" text="Rs. 0" styleClass="stat-value-loss"/>
                <Label text="Total Loss" styleClass="stat-label"/>
            </VBox>
            <VBox prefWidth="160" styleClass="stat-card">
                <Label fx:id="lblPending" text="0" styleClass="stat-value-amber"/>
                <Label text="Credit due" styleClass="stat-label"/>
            </VBox>
        </HBox>

        <!-- Filter Bar -->
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 0 28 12 28;">
            <TextField fx:id="txtFilter" promptText="Filter by company…"
                       onKeyReleased="#handleFilter" HBox.hgrow="ALWAYS"
                       styleClass="filter-field"/>
            <Label text="From" styleClass="filter-label"/>
            <DatePicker fx:id="dpFrom" onAction="#handleDateFilter" prefWidth="145" styleClass="date-picker"/>
            <Label text="to" styleClass="filter-label"/>
            <DatePicker fx:id="dpTo" onAction="#handleDateFilter" prefWidth="145" styleClass="date-picker"/>
        </HBox>

        <!-- Card List -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent; -fx-background: transparent;
                           -fx-border-color: transparent;">
            <padding><Insets left="28" right="28" bottom="24"/></padding>
            <VBox fx:id="cardContainer" spacing="8"/>
        </ScrollPane>

    </VBox>
</AnchorPane>
