<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane
        prefHeight="780.0" prefWidth="1100.0"
        style="-fx-background-color: #f1f5f9;"
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.gui.kline.controller.DashboardController">

    <children>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #f1f5f9; -fx-background-color: #f1f5f9; -fx-border-color: transparent;"
                    AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
                    AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">

            <VBox spacing="24.0">
                <padding><Insets top="28" left="28" right="28" bottom="28" /></padding>
                <HBox alignment="CENTER_LEFT" spacing="16">

                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Dashboard Overview"
                               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                        <Label text="Welcome back to your auto service shop"
                               style="-fx-font-size: 13px; -fx-text-fill: #64748b;" />
                    </VBox>

                    <HBox alignment="CENTER" spacing="0"
                          style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">

                        <HBox alignment="CENTER" spacing="6"
                              style="-fx-padding: 10 14 10 14; -fx-border-color: transparent #e2e8f0 transparent transparent; -fx-border-width: 0 1 0 0;">
                            <FontIcon iconLiteral="fas-calendar-alt" iconSize="14" iconColor="#94a3b8" />
                            <Label text="Date Range" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;" />
                        </HBox>

                        <HBox alignment="CENTER" spacing="4" style="-fx-padding: 6 10 6 10;">
                            <DatePicker fx:id="startDatePicker" promptText="Start date"
                                        style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13px; -fx-text-fill: #0f172a;" />
                            <Label text="—"
                                   style="-fx-text-fill: #cbd5e1; -fx-font-size: 13px; -fx-padding: 0 2 0 2;" />
                            <DatePicker fx:id="endDatePicker" promptText="End date"
                                        style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13px; -fx-text-fill: #0f172a;" />
                        </HBox>

                        <HBox alignment="CENTER"
                              style="-fx-padding: 8 14 8 10; -fx-border-color: transparent transparent transparent #e2e8f0; -fx-border-width: 0 0 0 1;">
                            <Button onAction="#refreshData"
                                    style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 7 16 7 16; -fx-cursor: hand; -fx-border-color: transparent;">
                                <graphic><FontIcon iconLiteral="fas-search" iconSize="11" iconColor="white" /></graphic>
                            </Button>
                        </HBox>
                    </HBox>
                </HBox>

                <GridPane hgap="16">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25" />
                    </columnConstraints>
                    <rowConstraints><RowConstraints /></rowConstraints>

                    <VBox spacing="14" GridPane.columnIndex="0"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 2); -fx-border-color: #f1f5f9; -fx-border-radius: 16;">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <StackPane style="-fx-background-color: #eff6ff; -fx-background-radius: 10; -fx-min-width: 44; -fx-min-height: 44; -fx-max-width: 44; -fx-max-height: 44;">
                                <FontIcon iconLiteral="fas-chart-line" iconSize="18" iconColor="#2563eb" />
                            </StackPane>
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="salesTrendLabel" text="+12.5% ↑"
                                   style="-fx-text-fill: #16a34a; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-color: #dcfce7; -fx-background-radius: 20; -fx-padding: 3 8 3 8;" />
                        </HBox>
                        <Label text="Period Sales"
                               style="-fx-text-fill: #94a3b8; -fx-font-size: 12px; -fx-font-weight: bold;" />
                        <Label fx:id="periodSalesLabel" text="Rs. 0"
                               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                    </VBox>

                    <VBox spacing="14" GridPane.columnIndex="1"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 2); -fx-border-color: #f1f5f9; -fx-border-radius: 16;">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <StackPane style="-fx-background-color: #f0fdf4; -fx-background-radius: 10; -fx-min-width: 44; -fx-min-height: 44; -fx-max-width: 44; -fx-max-height: 44;">
                                <FontIcon iconLiteral="fas-coins" iconSize="18" iconColor="#16a34a" />
                            </StackPane>
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="profitTrendLabel" text="+8.2% ↑"
                                   style="-fx-text-fill: #16a34a; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-color: #dcfce7; -fx-background-radius: 20; -fx-padding: 3 8 3 8;" />
                        </HBox>
                        <Label text="Period Profit"
                               style="-fx-text-fill: #94a3b8; -fx-font-size: 12px; -fx-font-weight: bold;" />
                        <Label fx:id="periodProfitLabel" text="Rs. 0"
                               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                    </VBox>

                    <VBox spacing="14" GridPane.columnIndex="2"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 2); -fx-border-color: #f1f5f9; -fx-border-radius: 16;">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <StackPane style="-fx-background-color: #faf5ff; -fx-background-radius: 10; -fx-min-width: 44; -fx-min-height: 44; -fx-max-width: 44; -fx-max-height: 44;">
                                <FontIcon iconLiteral="fas-tools" iconSize="18" iconColor="#7c3aed" />
                            </StackPane>
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="servicesTrendLabel" text="-2.4% ↓"
                                   style="-fx-text-fill: #dc2626; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-color: #fee2e2; -fx-background-radius: 20; -fx-padding: 3 8 3 8;" />
                        </HBox>
                        <Label text="Period Services"
                               style="-fx-text-fill: #94a3b8; -fx-font-size: 12px; -fx-font-weight: bold;" />
                        <Label fx:id="periodServicesLabel" text="0"
                               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                    </VBox>

                    <VBox spacing="14" GridPane.columnIndex="3"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 2); -fx-border-color: #f1f5f9; -fx-border-radius: 16;">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <StackPane style="-fx-background-color: #fff7ed; -fx-background-radius: 10; -fx-min-width: 44; -fx-min-height: 44; -fx-max-width: 44; -fx-max-height: 44;">
                                <FontIcon iconLiteral="fas-users" iconSize="18" iconColor="#ea580c" />
                            </StackPane>
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="workersTrendLabel" text="Stable ↑"
                                   style="-fx-text-fill: #16a34a; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-color: #dcfce7; -fx-background-radius: 20; -fx-padding: 3 8 3 8;" />
                        </HBox>
                        <Label text="Active Workers"
                               style="-fx-text-fill: #94a3b8; -fx-font-size: 12px; -fx-font-weight: bold;" />
                        <Label fx:id="activeWorkersLabel" text="0"
                               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                    </VBox>
                </GridPane>

                <HBox spacing="20" VBox.vgrow="ALWAYS">

                    <VBox spacing="16" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 2);">

                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label text="Revenue Overview"
                                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                                <Label text="Weekly sales performance"
                                       style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;" />
                            </VBox>
                            <ComboBox fx:id="chartRangeCombo"
                                      style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 12px;" />
                        </HBox>

                        <AreaChart fx:id="revenueChart" animated="true" legendVisible="false"
                                   style="-fx-background-color: transparent; -fx-padding: 0;"
                                   VBox.vgrow="ALWAYS">
                            <xAxis>
                                <CategoryAxis fx:id="xAxis"
                                              style="-fx-tick-label-font-size: 11px; -fx-tick-label-fill: #94a3b8;" />
                            </xAxis>
                            <yAxis>
                                <NumberAxis fx:id="yAxis" lowerBound="0" tickUnit="1000" upperBound="4500"
                                            style="-fx-tick-label-font-size: 11px; -fx-tick-label-fill: #94a3b8;" />
                            </yAxis>
                        </AreaChart>
                    </VBox>

                    <VBox spacing="16" minWidth="290" maxWidth="310">

                        <VBox spacing="0"
                              style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 2);">

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <StackPane style="-fx-background-color: #fffbeb; -fx-background-radius: 8; -fx-padding: 8;">
                                    <FontIcon iconLiteral="fas-bolt" iconSize="15" iconColor="#d97706" />
                                </StackPane>
                                <Label text="Quick Services (Period)"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                            </HBox>

                            <Region prefHeight="14" />

                            <HBox alignment="CENTER_LEFT"
                                  style="-fx-background-color: #f8fafc; -fx-background-radius: 10; -fx-padding: 12 14 12 14; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-border-width: 1;">
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <Label text="TOTAL COUNT"
                                           style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;" />
                                    <Label fx:id="quickServiceCountLabel" text="0"
                                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #d97706;" />
                                </VBox>
                                <VBox spacing="2" alignment="CENTER_RIGHT">
                                    <Label text="REVENUE"
                                           style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;" />
                                    <Label fx:id="quickServiceRevenueLabel" text="Rs. 0"
                                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #16a34a;" />
                                </VBox>
                            </HBox>
                        </VBox>

                        <VBox spacing="12" VBox.vgrow="ALWAYS"
                              style="-fx-background-color: #1a1a2e; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.14), 12, 0, 0, 3);">

                            <HBox alignment="CENTER_LEFT">
                                <HBox alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS">
                                    <StackPane style="-fx-background-color: #f59e0b; -fx-background-radius: 8; -fx-min-width: 32; -fx-min-height: 32; -fx-max-width: 32; -fx-max-height: 32;">
                                        <FontIcon iconLiteral="fas-bolt" iconSize="14" iconColor="#1a1a2e" />
                                    </StackPane>
                                    <Label text="Quick Actions"
                                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;" />
                                </HBox>
                                <Button onAction="#handleExpandQuickActions"
                                        style="-fx-background-color: #2d2d4e; -fx-text-fill: #94a3b8; -fx-font-size: 13px; -fx-cursor: hand; -fx-background-radius: 8; -fx-padding: 5 10; -fx-border-color: #3d3d6e; -fx-border-radius: 8;"
                                        text="Open" />
                            </HBox>

                            <GridPane fx:id="quickActionsGrid" hgap="10" vgap="10" VBox.vgrow="ALWAYS"
                                      style="-fx-background-color: #1a1a2e;">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                                </columnConstraints>
                            </GridPane>
                        </VBox>

                    </VBox>
                </HBox>

            </VBox>
        </ScrollPane>
    </children>
</AnchorPane>
