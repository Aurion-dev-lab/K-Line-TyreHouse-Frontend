<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: transparent;" stylesheets="@../css/expenses.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gui.kline.controller.ExpenseController">
    <VBox spacing="24" style="-fx-background-color: #f8fafc; -fx-padding: 32;" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        
        <HBox alignment="CENTER_LEFT">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Expenses Management" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #64748b;" text="Track shop expenses and costs" />
            </VBox>
            <Button fx:id="btnAddExpense" onAction="#handleAddExpense" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 24; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(16,185,129,0.3), 8, 0, 0, 3);" text="+ Add expense" />
        </HBox>

        <HBox spacing="24" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24 32; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
            
            <VBox spacing="4" minWidth="200" style="-fx-background-color: #fefce8; -fx-background-radius: 8; -fx-border-color: #fef08a; -fx-border-radius: 8; -fx-padding: 16 20;">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="fas-chart-pie" iconColor="#ca8a04" iconSize="16"/>
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #ca8a04;" text="TOTAL EXPENSES" />
                </HBox>
                <Label fx:id="lblTotalExpenses" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #854d0e;" text="Rs. 0.00" />
            </VBox>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <VBox spacing="12">
                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;" text="FILTER &amp; SEARCH" />
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <TextField fx:id="txtFilter" onKeyReleased="#handleFilter" prefWidth="250" promptText="Search description or category..." style="-fx-background-color: #f1f5f9; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 12; -fx-font-size: 13px;" />
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;" text="From:" />
                    <DatePicker fx:id="dpFrom" onAction="#handleDateFilter" prefWidth="140" style="-fx-background-color: #f1f5f9; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 4 8;" />
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;" text="To:" />
                    <DatePicker fx:id="dpTo" onAction="#handleDateFilter" prefWidth="140" style="-fx-background-color: #f1f5f9; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 4 8;" />
                </HBox>
            </VBox>
        </HBox>

        <VBox VBox.vgrow="ALWAYS" spacing="16" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24 32; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <FontIcon iconLiteral="fas-receipt" iconColor="#3b82f6" iconSize="16"/>
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Expense Records" />
            </HBox>
            <TableView fx:id="tblExpenses" prefHeight="200.0" styleClass="main-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colDate" prefWidth="120" text="Date" />
                    <TableColumn fx:id="colDescription" prefWidth="300" text="Description" />
                    <TableColumn fx:id="colCategory" prefWidth="150" text="Category" />
                    <TableColumn fx:id="colAmount" prefWidth="120" text="Amount" />
                    <TableColumn fx:id="colActions" prefWidth="120" text="Actions" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

    </VBox>
</AnchorPane>