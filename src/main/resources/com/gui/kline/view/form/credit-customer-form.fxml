<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="480.0" prefWidth="450.0" style="-fx-background-color: #F9FAFB;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.gui.kline.controller.form.CreditCustomerFormController">
   <children>
      <VBox spacing="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
         <children>
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 20 24 16 24;">
               <children>
                  <VBox spacing="3" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="lblTitle" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Add Credit Customer" />
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #6B7280;" text="Enter authorized credit customer details" />
                     </children>
                  </VBox>
                  <Label fx:id="lblBadge" managed="false" style="-fx-background-color: #f97316; -fx-text-fill: white; -fx-font-size: 10px; -fx-padding: 4 8; -fx-background-radius: 10; -fx-font-weight: bold;" text="EDITING" visible="false" />
               </children>
            </HBox>

            <!-- Form Content -->
            <VBox spacing="14" style="-fx-padding: 0 24 20 24;" VBox.vgrow="ALWAYS">
               <children>
                  <VBox spacing="4">
                     <children>
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #374151; -fx-font-weight: bold;" text="CUSTOMER NAME" />
                        <TextField fx:id="txtName" promptText="e.g. John Doe" style="-fx-background-color: white; -fx-border-color: #D1D5DB; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12; -fx-font-size: 13px;" />
                     </children>
                  </VBox>

                  <VBox spacing="4">
                     <children>
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #374151; -fx-font-weight: bold;" text="PHONE NUMBER" />
                        <TextField fx:id="txtPhone" promptText="e.g. 0771658034" style="-fx-background-color: white; -fx-border-color: #D1D5DB; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12; -fx-font-size: 13px;" />
                     </children>
                  </VBox>

                  <VBox spacing="4">
                     <children>
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #374151; -fx-font-weight: bold;" text="EMAIL ADDRESS (OPTIONAL)" />
                        <TextField fx:id="txtEmail" promptText="e.g. john@example.com" style="-fx-background-color: white; -fx-border-color: #D1D5DB; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12; -fx-font-size: 13px;" />
                     </children>
                  </VBox>

                  <VBox spacing="4">
                     <children>
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #374151; -fx-font-weight: bold;" text="PHYSICAL ADDRESS (OPTIONAL)" />
                        <TextField fx:id="txtAddress" promptText="e.g. 123 Main St, Colombo" style="-fx-background-color: white; -fx-border-color: #D1D5DB; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12; -fx-font-size: 13px;" />
                     </children>
                  </VBox>
               </children>
            </VBox>

            <!-- Footer Buttons -->
            <HBox alignment="CENTER_RIGHT" spacing="12" style="-fx-padding: 16 24 20 24; -fx-background-color: #F3F4F6;">
               <children>
                  <Button fx:id="btnCancel" onAction="#handleCancel" style="-fx-background-color: transparent; -fx-border-color: #D1D5DB; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px; -fx-text-fill: #374151; -fx-padding: 8 16; -fx-cursor: hand;" text="Cancel" />
                  <Button fx:id="btnSave" onAction="#handleSave" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand;" text="Save Customer" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
