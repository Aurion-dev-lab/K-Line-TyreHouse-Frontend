<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane styleClass="modal-overlay"
            stylesheets="@../../css/payment-history-dialog.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gui.kline.controller.form.PaymentHistoryDialogController">

    <StackPane AnchorPane.topAnchor="0"
               AnchorPane.bottomAnchor="0"
               AnchorPane.leftAnchor="0"
               AnchorPane.rightAnchor="0">

        <VBox styleClass="modal-card" maxWidth="560" minWidth="460" spacing="0">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox.margin><Insets top="24" left="24" right="24" bottom="16" /></VBox.margin>

                <StackPane styleClass="header-icon">
                    <SVGPath styleClass="header-icon-path"
                             content="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z" />
                </StackPane>

                <VBox spacing="2">
                    <Label fx:id="lblTitle" styleClass="modal-title" text="Payment History" />
                    <Label fx:id="lblSubtitle" styleClass="modal-subtitle" text="All recorded payments for this entry" />
                </VBox>
            </HBox>

            <Region styleClass="modal-divider" prefHeight="1" maxHeight="1" />

            <!-- Summary Bar -->
            <HBox styleClass="summary-bar" spacing="0" alignment="CENTER">
                <VBox.margin><Insets top="16" left="20" right="20" bottom="0" /></VBox.margin>

                <VBox alignment="CENTER" HBox.hgrow="ALWAYS" spacing="2" style="-fx-padding: 12 0 12 0;">
                    <Label text="TOTAL DUE" styleClass="summary-label" />
                    <Label fx:id="lblTotalDue" text="Rs. 0" styleClass="summary-value" />
                </VBox>

                <Region prefWidth="1" maxWidth="1" style="-fx-background-color: #D8E4DF;" minHeight="40" />

                <VBox alignment="CENTER" HBox.hgrow="ALWAYS" spacing="2" style="-fx-padding: 12 0 12 0;">
                    <Label text="TOTAL PAID" styleClass="summary-label" />
                    <Label fx:id="lblTotalPaid" text="Rs. 0" styleClass="summary-value-green" />
                </VBox>

                <Region prefWidth="1" maxWidth="1" style="-fx-background-color: #D8E4DF;" minHeight="40" />

                <VBox alignment="CENTER" HBox.hgrow="ALWAYS" spacing="2" style="-fx-padding: 12 0 12 0;">
                    <Label text="BALANCE" styleClass="summary-label" />
                    <Label fx:id="lblBalance" text="Rs. 0" styleClass="summary-value-red" />
                </VBox>
            </HBox>

            <!-- Payment list -->
            <ScrollPane fitToWidth="true" styleClass="scroll-pane"
                        minHeight="200" maxHeight="360" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER">
                <VBox.margin><Insets top="12" left="0" right="0" bottom="0" /></VBox.margin>
                <content>
                    <VBox fx:id="vboxPayments" spacing="8">
                        <padding><Insets top="4" left="20" right="20" bottom="12" /></padding>
                    </VBox>
                </content>
            </ScrollPane>

            <!-- Footer -->
            <Region styleClass="modal-divider" prefHeight="1" maxHeight="1">
                <VBox.margin><Insets top="4" /></VBox.margin>
            </Region>

            <HBox alignment="CENTER_RIGHT">
                <padding><Insets top="16" left="24" right="24" bottom="24" /></padding>
                <Button text="Close" styleClass="btn-close"
                        onAction="#onClose" prefWidth="120" prefHeight="42" />
            </HBox>

        </VBox>
    </StackPane>
</AnchorPane>