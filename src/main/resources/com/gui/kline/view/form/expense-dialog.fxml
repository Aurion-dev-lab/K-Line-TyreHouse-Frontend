<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefWidth="480.0" style="-fx-background-color: transparent;" stylesheets="@../../css/expenses.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.gui.kline.controller.form.ExpenseDialogController">

    <VBox spacing="0" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 4);" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <!-- Header -->
        <VBox style="-fx-padding: 24 32 20 32; -fx-background-color: #f8fafc; -fx-background-radius: 12 12 0 0; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Add Expense" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: #64748b;" text="Record a new shop expense" />
        </VBox>

        <!-- Form Fields -->
        <VBox spacing="20" style="-fx-padding: 24 32 32 32;">
            <VBox spacing="8">
                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Date" />
                <DatePicker fx:id="dpDate" maxWidth="Infinity" />
            </VBox>

            <VBox spacing="8">
                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Description" />
                <TextField fx:id="txtDescription" promptText="Enter expense description" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 10 14; -fx-font-size: 13px;" />
            </VBox>

            <VBox spacing="8">
                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Category" />
                <ComboBox fx:id="cmbCategory" promptText="Select category" maxWidth="Infinity" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 4 8; -fx-font-size: 13px;" />
            </VBox>

            <VBox spacing="8">
                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Amount (Rs.)" />
                <TextField fx:id="txtAmount" promptText="0.00" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 10 14; -fx-font-size: 13px; -fx-font-weight: bold;" />
            </VBox>
        </VBox>

        <!-- Actions -->
        <HBox alignment="CENTER_RIGHT" spacing="12" style="-fx-padding: 20 32; -fx-background-color: #f8fafc; -fx-background-radius: 0 0 12 12; -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0;">
            <Button fx:id="btnCancel" onAction="#handleCancel" prefHeight="40" prefWidth="100" style="-fx-background-color: transparent; -fx-border-color: #cbd5e1; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #64748b; -fx-cursor: hand;" text="Cancel" />
            <Button fx:id="btnSave" onAction="#handleSave" prefHeight="40" prefWidth="140" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 2);" text="Save Expense" />
        </HBox>

    </VBox>
</AnchorPane>
