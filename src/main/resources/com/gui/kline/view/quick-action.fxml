<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane
        prefHeight="720.0" prefWidth="1000.0"
        style="-fx-background-color: #f8fafc;"
        stylesheets="@../css/expenses.css"
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.gui.kline.controller.QuickActionController">

    <children>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;"
                    AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
                    AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">

            <VBox spacing="24.0">
                <padding><Insets top="28" left="32" right="32" bottom="32" /></padding>

                <!-- ── Page Header Card ── -->
                <HBox alignment="CENTER_LEFT" spacing="16"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24 32; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                    <VBox spacing="4">
                        <Label text="Quick Action Management"
                               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                        <Label text="Configure one-tap services shown on Dashboard and Services sidebar"
                               style="-fx-font-size: 13px; -fx-text-fill: #64748b;" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <!-- Stats Chips -->
                    <HBox spacing="16" alignment="CENTER">
                        <VBox alignment="CENTER"
                              style="-fx-background-color: #ecfdf5; -fx-border-color: #a7f3d0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 24; -fx-min-width: 100;">
                            <Label fx:id="lblActiveCount" text="0"
                                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #059669;" />
                            <Label text="ACTIVE" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #10b981;" />
                        </VBox>
                        <VBox alignment="CENTER"
                              style="-fx-background-color: #eff6ff; -fx-border-color: #bfdbfe; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 24; -fx-min-width: 100;">
                            <Label fx:id="lblTotalCount" text="0"
                                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2563eb;" />
                            <Label text="TOTAL" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #3b82f6;" />
                        </VBox>
                    </HBox>
                </HBox>

                <!-- ── Main Content Grid ── -->
                <GridPane hgap="24" vgap="24">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="35" />
                        <ColumnConstraints percentWidth="65" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints />
                    </rowConstraints>

                    <!-- LEFT: Add / Edit Form Card -->
                    <VBox spacing="20" GridPane.columnIndex="0" GridPane.rowIndex="0"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24 32; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                        
                        <!-- Card Header -->
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <StackPane style="-fx-background-color: #fef3c7; -fx-background-radius: 8; -fx-padding: 8;">
                                <FontIcon iconLiteral="fas-plus-circle" iconSize="16" iconColor="#d97706" />
                            </StackPane>
                            <Label fx:id="lblFormTitle" text="Add New Quick Action"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                        </HBox>

                        <Separator style="-fx-padding: 4 0;" />

                        <!-- Status Message -->
                        <Label fx:id="lblMessage" text="" visible="false" managed="false"
                               wrapText="true"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 12; -fx-max-width: infinity;" />

                        <!-- Service Name -->
                        <VBox spacing="6">
                            <Label text="Service Name" style="-fx-font-size: 12px; -fx-text-fill: #475569; -fx-font-weight: bold;" />
                            <TextField fx:id="txtService" promptText="e.g. Tyre Air Fill"
                                       style="-fx-background-color: #f1f5f9; -fx-border-color: #e2e8f0; -fx-text-fill: #010101ff; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 12; -fx-font-size: 13px;" />
                        </VBox>

                        <!-- Price -->
                        <VBox spacing="6">
                            <Label text="Price (Rs.)" style="-fx-font-size: 12px; -fx-text-fill: #475569; -fx-font-weight: bold;" />
                            <TextField fx:id="txtPrice" promptText="0.00"
                                       style="-fx-background-color: #f1f5f9; -fx-border-color: #e2e8f0; -fx-text-fill: black; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 12; -fx-font-size: 13px;" />
                        </VBox>

                        <!-- Icon -->
                        <VBox spacing="6">
                            <Label text="Icon" style="-fx-font-size: 12px; -fx-text-fill: #475569; -fx-font-weight: bold;" />
                            <ComboBox fx:id="cmbIcon" maxWidth="Infinity" promptText="Select icon"
                                      style="-fx-background-color: #f1f5f9; -fx-border-color: #e2e8f0; -fx-text-fill: black; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px; -fx-padding: 2;" />
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <!-- Action Buttons -->
                        <VBox spacing="10">
                            <Button fx:id="btnAdd" text="  Add Quick Action" maxWidth="Infinity"
                                    onAction="#handleAddPreset"
                                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 12 0; -fx-cursor: hand;">
                                <graphic><FontIcon iconLiteral="fas-plus" iconSize="13" iconColor="white" /></graphic>
                            </Button>
                            <Button fx:id="btnSave" text="  Save Changes" maxWidth="Infinity"
                                    onAction="#handleSavePreset" visible="false" managed="false"
                                    style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 12 0; -fx-cursor: hand;">
                                <graphic><FontIcon iconLiteral="fas-check" iconSize="13" iconColor="white" /></graphic>
                            </Button>
                            <Button fx:id="btnCancel" text="  Cancel Edit" maxWidth="Infinity"
                                    onAction="#handleCancelEdit" visible="false" managed="false"
                                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 12 0; -fx-cursor: hand;">
                                <graphic><FontIcon iconLiteral="fas-times" iconSize="13" iconColor="#334155" /></graphic>
                            </Button>
                        </VBox>
                    </VBox>

                    <!-- RIGHT: Presets Table Card -->
                    <VBox spacing="16" GridPane.columnIndex="1" GridPane.rowIndex="0"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24 32; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                        
                        <!-- Card Header -->
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <StackPane style="-fx-background-color: #eff6ff; -fx-background-radius: 8; -fx-padding: 8;">
                                <FontIcon iconLiteral="fas-list-alt" iconSize="16" iconColor="#2563eb" />
                            </StackPane>
                            <Label text="Configured Quick Actions"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label text="Select a row to Edit / Toggle / Delete"
                                   style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;" />
                        </HBox>

                        <Separator style="-fx-padding: 4 0;" />

                        <!-- Table -->
                        <TableView fx:id="tblPresets" VBox.vgrow="ALWAYS" minHeight="360" styleClass="main-table">
                            <columns>
                                <TableColumn fx:id="colIcon" text="ICON" prefWidth="70.0" />
                                <TableColumn fx:id="colService" text="SERVICE NAME" prefWidth="250.0" />
                                <TableColumn fx:id="colPrice" text="PRICE" prefWidth="120.0" />
                                <TableColumn fx:id="colStatus" text="STATUS" prefWidth="120.0" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <!-- Row Action Buttons -->
                        <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 12 0 0 0;">
                            <Button text=" Edit" onAction="#handleEditPreset"
                                    style="-fx-background-color: transparent; -fx-border-color: #d97706; -fx-text-fill: #d97706; -fx-border-radius: 6; -fx-padding: 7 16; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 12px;">
                                <graphic><FontIcon iconLiteral="fas-edit" iconSize="12" iconColor="#d97706" /></graphic>
                            </Button>
                            <Button text=" Toggle Enable" onAction="#handleTogglePreset"
                                    style="-fx-background-color: transparent; -fx-border-color: #059669; -fx-text-fill: #059669; -fx-border-radius: 6; -fx-padding: 7 16; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 12px;">
                                <graphic><FontIcon iconLiteral="fas-toggle-on" iconSize="12" iconColor="#059669" /></graphic>
                            </Button>
                            <Button text=" Delete" onAction="#handleDeletePreset"
                                    style="-fx-background-color: transparent; -fx-border-color: #dc2626; -fx-text-fill: #dc2626; -fx-border-radius: 6; -fx-padding: 7 16; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 12px;">
                                <graphic><FontIcon iconLiteral="fas-trash" iconSize="12" iconColor="#dc2626" /></graphic>
                            </Button>
                        </HBox>
                    </VBox>
                </GridPane>
            </VBox>
        </ScrollPane>
    </children>
</AnchorPane>
